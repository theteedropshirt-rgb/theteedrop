---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';

const BASE_URL = "https://theteedrop.com";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "The Tee Drop Catalog",
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${BASE_URL}/products/${p.slug}`,
    "name": p.title
  }))
};
---

<BaseLayout
  title="theteedrop | Boutique de Graphic Tees & Vêtements Streetwear"
  description="Boutique officielle The Tee Drop. Graphic tees imprimés sur commande avec expédition internationale suivie."
  schema={itemListSchema}
>
  <main class="storefront-page">
    <div class="container">

      <!-- Subheader / Filter Controls Bar (Exact Mayzing layout) -->
      <div class="filter-controls-bar">
        <button class="btn-toggle-filters" id="btn-toggle-filters" type="button" aria-expanded="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"></line>
            <line x1="4" y1="12" x2="14" y2="12"></line>
            <line x1="4" y1="18" x2="9" y2="18"></line>
          </svg>
          <span>Filtre</span>
        </button>

        <div class="store-count-status">
          Montrer <span id="visible-count">{products.length}</span> de <span id="total-count">{products.length}</span> articles
        </div>
      </div>

      <!-- Main Store Body: 2 Columns (Sidebar + Grid) -->
      <div class="storefront-layout">
        
        <!-- Left Sidebar: Filter Accordions -->
        <aside class="store-sidebar" id="store-sidebar">
          
          <!-- Category Section -->
          <div class="filter-group">
            <div class="filter-group-header">
              <h4>Catégorie</h4>
              <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
            </div>
            <div class="filter-options">
              <label class="filter-radio-label">
                <input type="radio" name="filter-cat" value="T-Shirts" checked class="filter-input-radio" />
                <span class="custom-radio"></span>
                <span class="filter-text">T-Shirts</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="filter-cat" value="Sweat-shirts" class="filter-input-radio" />
                <span class="custom-radio"></span>
                <span class="filter-text">Sweat-shirts</span>
              </label>
              <label class="filter-radio-label">
                <input type="radio" name="filter-cat" value="Manches longues" class="filter-input-radio" />
                <span class="custom-radio"></span>
                <span class="filter-text">Manches longues</span>
              </label>
            </div>
          </div>

          <!-- Product Type / Gender Section -->
          <div class="filter-group">
            <div class="filter-group-header">
              <h4>Type d'article</h4>
              <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="18 15 12 9 6 15"></polyline>
              </svg>
            </div>
            <div class="filter-options">
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-gender" value="Hommes" class="filter-input-checkbox" />
                <span class="custom-checkbox"></span>
                <span class="filter-text">Hommes</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-gender" value="Femmes" class="filter-input-checkbox" />
                <span class="custom-checkbox"></span>
                <span class="filter-text">Femmes</span>
              </label>
              <label class="filter-checkbox-label">
                <input type="checkbox" name="filter-gender" value="Unisexe" checked class="filter-input-checkbox" />
                <span class="custom-checkbox"></span>
                <span class="filter-text">Unisexe</span>
              </label>
            </div>
          </div>

        </aside>

        <!-- Right Side: Products Grid -->
        <section class="store-grid-wrapper">
          <div class="products-grid-catalog" id="products-catalog">
            {products.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>

          <!-- Zero Search Results State -->
          <div class="no-results-state" id="no-results" style="display: none;">
            <h3>Aucun article trouvé</h3>
            <p>Essayez d'ajuster votre recherche ou réinitialisez les filtres.</p>
            <button type="button" class="btn-reset-filters" id="btn-reset-filters">
              Réinitialiser les filtres
            </button>
          </div>
        </section>

      </div>

    </div>
  </main>
</BaseLayout>

<style>
  .storefront-page {
    padding: 16px 0 60px;
    background: #ffffff;
    min-height: 80vh;
  }

  /* Subheader Filter Controls Bar */
  .filter-controls-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .btn-toggle-filters {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: #111827;
    cursor: pointer;
    padding: 6px 10px;
    border-radius: 6px;
    transition: background 0.15s ease;
  }
  .btn-toggle-filters:hover {
    background: #f3f4f6;
  }
  .store-count-status {
    font-size: 0.88rem;
    color: #4b5563;
    font-weight: 400;
  }

  /* Storefront Layout (2 Columns) */
  .storefront-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 36px;
    align-items: start;
    transition: all 0.3s ease;
  }
  .storefront-layout.sidebar-hidden {
    grid-template-columns: 1fr;
  }
  .storefront-layout.sidebar-hidden .store-sidebar {
    display: none;
  }

  /* Sidebar Styling */
  .store-sidebar {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .filter-group {
    border-bottom: 1px solid var(--border);
    padding-bottom: 18px;
  }
  .filter-group-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    cursor: pointer;
  }
  .filter-group-header h4 {
    font-size: 0.92rem;
    font-weight: 600;
    color: #111827;
  }
  .chevron-icon {
    color: #6b7280;
  }

  /* Filter Options & Labels */
  .filter-options {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .filter-radio-label,
  .filter-checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.88rem;
    color: #374151;
    cursor: pointer;
    user-select: none;
  }
  .filter-input-radio,
  .filter-input-checkbox {
    position: absolute;
    opacity: 0;
    cursor: pointer;
  }

  /* Custom Radio styling */
  .custom-radio {
    width: 18px;
    height: 18px;
    border: 1.5px solid #6b7280;
    border-radius: 50%;
    display: inline-block;
    position: relative;
    transition: border-color 0.15s ease;
  }
  .filter-input-radio:checked ~ .custom-radio {
    border-color: #111827;
  }
  .filter-input-radio:checked ~ .custom-radio::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #111827;
  }

  /* Custom Checkbox styling */
  .custom-checkbox {
    width: 18px;
    height: 18px;
    border: 1.5px solid #6b7280;
    border-radius: 3px;
    display: inline-block;
    position: relative;
    transition: all 0.15s ease;
  }
  .filter-input-checkbox:checked ~ .custom-checkbox {
    background: #111827;
    border-color: #111827;
  }
  .filter-input-checkbox:checked ~ .custom-checkbox::after {
    content: '✓';
    position: absolute;
    top: -2px;
    left: 3px;
    font-size: 0.72rem;
    color: #ffffff;
    font-weight: 800;
  }

  /* Products Grid */
  .products-grid-catalog {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
  }

  @media(max-width: 768px) {
    .storefront-layout {
      grid-template-columns: 1fr;
    }
    .store-sidebar {
      margin-bottom: 24px;
    }
  }

  /* No Results State */
  .no-results-state {
    text-align: center;
    padding: 60px 20px;
    background: #f9fafb;
    border-radius: 8px;
    border: 1px dashed var(--border);
    margin-top: 10px;
    width: 100%;
  }
  .no-results-state h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    margin-bottom: 4px;
  }
  .no-results-state p {
    color: #6b7280;
    font-size: 0.88rem;
    margin-bottom: 16px;
  }
  .btn-reset-filters {
    background: #111827;
    color: #ffffff;
    border: none;
    padding: 8px 18px;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('store-search-input');
    const categoryRadios = document.querySelectorAll('input[name="filter-cat"]');
    const genderCheckboxes = document.querySelectorAll('input[name="filter-gender"]');
    const cards = document.querySelectorAll('.mayzing-card-wrapper');
    const visibleCountEl = document.getElementById('visible-count');
    const noResultsEl = document.getElementById('no-results');
    const btnReset = document.getElementById('btn-reset-filters');
    const btnToggleFilters = document.getElementById('btn-toggle-filters');
    const layoutWrapper = document.querySelector('.storefront-layout');

    // Toggle Sidebar
    if (btnToggleFilters && layoutWrapper) {
      btnToggleFilters.addEventListener('click', () => {
        layoutWrapper.classList.toggle('sidebar-hidden');
      });
    }

    function filterStore() {
      const query = (searchInput ? searchInput.value : '').trim().toLowerCase();
      
      let selectedCat = '';
      categoryRadios.forEach(r => {
        if (r.checked) selectedCat = r.value;
      });

      const selectedGenders = [];
      genderCheckboxes.forEach(cb => {
        if (cb.checked) selectedGenders.push(cb.value);
      });

      let visibleCount = 0;

      cards.forEach(card => {
        const title = (card.getAttribute('data-title') || '').toLowerCase();
        const category = card.getAttribute('data-category') || '';
        const gender = card.getAttribute('data-gender') || '';

        const matchesSearch = !query || title.includes(query) || category.toLowerCase().includes(query);
        const matchesCategory = !selectedCat || (category === selectedCat);
        const matchesGender = (selectedGenders.length === 0) || selectedGenders.includes(gender) || (gender === 'Unisexe');

        if (matchesSearch && matchesCategory && matchesGender) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = visibleCount;
      if (noResultsEl) {
        noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', filterStore);
    }
    categoryRadios.forEach(r => r.addEventListener('change', filterStore));
    genderCheckboxes.forEach(cb => cb.addEventListener('change', filterStore));

    if (btnReset) {
      btnReset.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        categoryRadios.forEach(r => { r.checked = (r.value === 'T-Shirts'); });
        genderCheckboxes.forEach(cb => { cb.checked = (cb.value === 'Unisexe'); });
        filterStore();
      });
    }

    window.searchStore = filterStore;
  });
</script>
