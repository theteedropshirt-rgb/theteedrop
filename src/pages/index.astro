---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import categories from '../data/categories.json';
import articles from '../data/articles.json';

const BASE_URL = "https://theteedrop.com";
const MAYZING_STORE = "https://ecotwins.store";

const featuredCategories = categories.slice(0, 12);

const itemListSchema = products.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Live Limited Drops",
  "itemListElement": products.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${BASE_URL}/products/${p.slug}`,
    "name": p.title
  }))
} : null;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Why is 240+ GSM heavyweight cotton better than ordinary t-shirts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Standard mass-market graphic tees use 140–160 GSM lightweight blanks that curl at the collar and distort after two washes. Our 240+ GSM combed ringspun cotton retains a structured, boxy drape, sits cleanly over all body types, and provides a dense canvas that prevents graphic cracking."
      }
    },
    {
      "@type": "Question",
      "name": "How fast is shipping to the US, Canada, UK, and Europe?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every order is routed to the certified printing facility closest to your shipping address (USA, Canada, UK, or EU). Average transit is 3 to 5 business days for US and Canadian orders, and 4 to 7 business days for Europe."
      }
    },
    {
      "@type": "Question",
      "name": "What is the 30-Day Reprint Guarantee?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your shirt arrives with any printing defect, misaligned graphic, transit damage, or sizing issue, our support team will reprint and dispatch a replacement 100% free of charge within 30 days of delivery."
      }
    }
  ]
};

const schemas = [faqSchema];
if (itemListSchema) schemas.unshift(itemListSchema);

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": schemas
};
---

<BaseLayout
  title="The Tee Drop | Premium Heavyweight Graphic Tees & Streetwear"
  description="DTC graphic apparel printed on demand on custom 240+ GSM combed ringspun cotton blanks. 45+ curated niche hubs and local US & European fulfillment."
  schema={pageSchema}
>
  <!-- Hero Section -->
  <section class="wicked-hero">
    <div class="container hero-content-wrapper">
      <div class="hero-text-block">
        <div class="scarcity-pill">
          <span class="pulsing-dot"></span> HEAVYWEIGHT GRAPHIC APPAREL • 240+ GSM
        </div>
        <h1>GRAPHIC TEES FOR PEOPLE WHO HATE THIN SHIRTS.</h1>
        <p class="hero-lead">
          Custom-knitted 240+ GSM combed ringspun cotton. Printed on demand with water-based, non-toxic inks that penetrate deep into natural fibers instead of cracking or peeling.
        </p>

        <div class="hero-cta-cluster">
          <a href="/collections" class="btn-hero-primary">EXPLORE 45+ COLLECTIONS</a>
          <a href="/size-guide" class="btn-hero-secondary">VIEW SIZE CHART →</a>
        </div>

        <div class="hero-proof-stats">
          <div class="stat-item">
            <strong>240+ GSM</strong>
            <span>Heavy Combed Cotton</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <strong>45+ Hubs</strong>
            <span>Curated Topics & Niches</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat-item">
            <strong>3–5 Days</strong>
            <span>Average US Delivery</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Topic Filter Bar -->
  <section class="topic-filter-bar">
    <div class="container">
      <div class="filter-flex-row">
        <span class="filter-title">Quick Jump:</span>
        <div class="filter-pills-scroll">
          <a href="/collections" class="filter-pill active">All 45+ Collections</a>
          {featuredCategories.map((c) => (
            <a href={`/collections/${c.slug}`} class="filter-pill">
              {c.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Master Topic Hubs Matrix (Internal Backlink Powerhouse) -->
  <section class="topic-showcase-section">
    <div class="container">
      <div class="showcase-header">
        <span class="sub-label">Topic Directory</span>
        <h2>EXPLORE DROPS BY PASSION, CAREER & AESTHETIC</h2>
        <p>Direct access to each curated subculture hub. 45+ dedicated collections crafted on our signature 240+ GSM combed blanks.</p>
      </div>

      <div class="topic-showcase-grid">
        {featuredCategories.map((c) => (
          <a href={`/collections/${c.slug}`} class="topic-card">
            <span class="topic-badge">{c.badge}</span>
            <h3>{c.name}</h3>
            <p>{c.intro.slice(0, 115)}...</p>
            <span class="topic-link">Explore Hub →</span>
          </a>
        ))}
      </div>

      <div class="view-all-center">
        <a href="/collections" class="btn-view-all-collections">View All 45+ Specialized Topic Hubs →</a>
      </div>
    </div>
  </section>

  <!-- Main Drops Container -->
  <main class="container" id="drops">
    <div class="catalog-header-row">
      <div>
        <h2>LIVE DROPS & PRODUCT ARCHIVE</h2>
        <p>Heavyweight graphic drops printed on demand and fulfilled via Mayzing.</p>
      </div>
      <div class="sort-indicator">
        {products.length > 0 ? (
          <span>Showing <strong>{products.length} Products</strong></span>
        ) : (
          <span>Storefront Status: <strong>Ready for Listings</strong></span>
        )}
      </div>
    </div>

    <!-- Product Grid or Zero-Listing State -->
    {products.length > 0 ? (
      <div class="pro-grid-4col">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    ) : (
      <div class="empty-state-card">
        <span class="empty-state-badge">READY FOR DROPS</span>
        <h3>Zero Listings Published Yet</h3>
        <p>
          Your storefront framework is configured and ready to receive your products from Mayzing. Once you add your drops, they will appear right here with high-resolution imagery and direct checkout links.
        </p>
        <div class="empty-state-actions">
          <a href={MAYZING_STORE} target="_blank" rel="noopener" class="btn-empty-hero">Visit Mayzing Storefront →</a>
          <a href="/size-guide" class="btn-empty-outline">Check Sizing & Fit Specs</a>
        </div>
      </div>
    )}
  </main>

  <!-- Fabric & Craftsmanship Authority Section -->
  <section class="fabric-authority-section" id="fabric">
    <div class="container">
      <div class="authority-box">
        <div class="authority-text">
          <span class="quality-tag">THE 240+ GSM STANDARD</span>
          <h2>WHY CHEAP T-SHIRTS RUIN YOUR WARDROBE</h2>
          <p>
            Most print-on-demand sellers cut corners with cheap 140–160 GSM blanks because they cost less to ship. After two washes, the seams twist, the collar wrinkles like bacon, and the shirt clings awkwardly.
          </p>
          <p>
            We custom knit our combed ringspun cotton at <strong>240+ grams per square meter</strong>. The fabric holds its boxy structure, breathes effortlessly, and drapes cleanly over your frame.
          </p>

          <div class="spec-badges-row">
            <div class="spec-pill">100% Combed Ringspun Cotton</div>
            <div class="spec-pill">Pre-Shrunk Enzyme Washed</div>
            <div class="spec-pill">Lay-Flat 1-Inch Ribbed Collar</div>
            <div class="spec-pill">Water-Based Non-Toxic DTG Inks</div>
          </div>

          <div class="authority-actions">
            <a href="/size-guide" class="btn-learn-sizing">View Exact Size & Measurement Chart →</a>
            <a href="/collections" class="btn-learn-secondary">Explore All 45+ Collections →</a>
          </div>
        </div>

        <div class="authority-media">
          <img src="https://images.unsplash.com/photo-1529139574466-a303027c1d8b?w=800&auto=format&fit=crop&q=80" alt="Heavyweight Combed Cotton Fabric" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Editorial Journal Section (E-E-A-T) -->
  <section class="container" style="margin-top: 90px; margin-bottom: 90px;">
    <div class="catalog-header-row">
      <div>
        <h2>THE TEE DROP JOURNAL</h2>
        <p>In-depth guides on fabric longevity, styling oversized drops, and apparel care.</p>
      </div>
      <a href="/blog" class="view-all-link">Read all 6 guides →</a>
    </div>

    <div class="journal-3col">
      {articles.slice(0, 3).map((a) => (
        <a href={`/blog/${a.slug}`} class="article-preview-card">
          <img src={a.image} alt={a.title} loading="lazy" />
          <div class="article-body">
            <span class="art-cat">{a.category}</span>
            <h3>{a.title}</h3>
            <p>{a.excerpt}</p>
            <span class="read-more">Read article ({a.read_time}) →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq-container-section" id="faq">
    <div class="container">
      <div class="faq-header-block">
        <span class="faq-badge">Got Questions?</span>
        <h2>FREQUENTLY ASKED QUESTIONS</h2>
        <p>Everything you need to know about our blanks, sizing, printing, and returns.</p>
      </div>

      <div class="faq-accordion-group">
        <details class="pro-faq-item">
          <summary>What makes your 240+ GSM blanks different from ordinary shirts?</summary>
          <div class="faq-body">
            Standard mass-market graphic tees use 140–160 GSM lightweight blanks that curl at the collar and distort after two washes. Our 240+ GSM combed ringspun cotton retains a structured, boxy drape, sits cleanly over all body types, and provides a dense canvas that prevents graphic cracking over dozens of wash cycles.
          </div>
        </details>

        <details class="pro-faq-item">
          <summary>How fast will my order arrive in the US, Canada, UK, or Europe?</summary>
          <div class="faq-body">
            Every order is routed to the certified printing facility closest to your shipping address (USA, Canada, UK, or European Union). Average transit time is 3 to 5 business days for US and Canadian orders, and 4 to 7 business days for the UK and Europe, complete with real-time door-to-door tracking.
          </div>
        </details>

        <details class="pro-faq-item">
          <summary>How do The Tee Drop shirts fit? Should I size up?</summary>
          <div class="faq-body">
            Our shirts are cut with an intentional modern relaxed streetwear silhouette featuring slightly dropped shoulders and a flat-laying 1-inch ribbed collar. If you want a comfortable everyday relaxed fit, order your normal true-to-size. If you prefer an oversized boxy drape or gym pump cover fit, we recommend ordering one size up. Check our <a href="/size-guide" style="color: var(--blue-primary); text-decoration: underline;">Size Guide</a> for exact measurements.
          </div>
        </details>

        <details class="pro-faq-item">
          <summary>What is your 30-Day Reprint Guarantee policy?</summary>
          <div class="faq-body">
            We stand behind every single print run. If your item arrives with any manufacturing flaw, misprinted artwork, transit damage, or sizing issue, our support team will reprint and dispatch a brand-new replacement completely free of charge within 30 days of delivery.
          </div>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .wicked-hero {
    background: radial-gradient(circle at 50% 10%, #f0f9ff 0%, #ffffff 85%);
    border-bottom: 1px solid var(--border);
    padding: 90px 0 70px;
    text-align: center;
  }
  .hero-content-wrapper {
    max-width: 950px;
  }
  .scarcity-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #0f172a;
    color: #ffffff;
    padding: 6px 18px;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.8px;
    margin-bottom: 24px;
  }
  .pulsing-dot {
    width: 8px;
    height: 8px;
    background: #38bdf8;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }
  .hero-text-block h1 {
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1.5px;
    color: #0f172a;
    margin-bottom: 20px;
  }
  .hero-lead {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-muted);
    max-width: 780px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }
  .hero-cta-cluster {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
    flex-wrap: wrap;
  }
  .btn-hero-primary {
    background: var(--blue-primary);
    color: #ffffff;
    padding: 16px 36px;
    border-radius: 6px;
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
  }
  .btn-hero-primary:hover {
    background: var(--blue-hover);
    transform: translateY(-2px);
  }
  .btn-hero-secondary {
    background: #ffffff;
    color: #0f172a;
    border: 1px solid var(--border-dark);
    padding: 16px 32px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
  }
  .btn-hero-secondary:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
  }
  .hero-proof-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    border-top: 1px solid var(--border);
    padding-top: 32px;
    max-width: 650px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .stat-item strong {
    font-size: 1.4rem;
    font-weight: 900;
    color: #0f172a;
  }
  .stat-item span {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .stat-divider {
    width: 1px;
    height: 30px;
    background: var(--border);
  }

  /* Topic Filter Bar */
  .topic-filter-bar {
    background: #ffffff;
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
    position: sticky;
    top: 69px;
    z-index: 99;
  }
  .filter-flex-row {
    display: flex;
    align-items: center;
    gap: 20px;
    overflow: hidden;
  }
  .filter-title {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
  .filter-pills-scroll {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    white-space: nowrap;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }
  .filter-pill {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    padding: 7px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
  }
  .filter-pill:hover, .filter-pill.active {
    background: var(--blue-primary);
    color: #ffffff;
    border-color: var(--blue-primary);
  }

  /* Topic Showcase Section */
  .topic-showcase-section {
    background: var(--bg-soft);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 80px 0;
  }
  .showcase-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 50px;
  }
  .sub-label {
    display: inline-block;
    color: var(--blue-primary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .showcase-header h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 900;
    letter-spacing: -0.5px;
    margin-bottom: 12px;
  }
  .showcase-header p {
    color: var(--text-muted);
    font-size: 1rem;
  }
  .topic-showcase-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }
  .topic-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }
  .topic-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--blue-primary);
  }
  .topic-badge {
    align-self: flex-start;
    background: var(--blue-light);
    color: var(--blue-hover);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  .topic-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: var(--text);
  }
  .topic-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 18px;
  }
  .topic-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--blue-primary);
  }
  .view-all-center {
    text-align: center;
    margin-top: 45px;
  }
  .btn-view-all-collections {
    display: inline-block;
    background: #ffffff;
    border: 1px solid var(--border-dark);
    color: var(--text);
    padding: 14px 32px;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .btn-view-all-collections:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
    box-shadow: var(--shadow-sm);
  }

  /* Main Catalog */
  main#drops {
    padding-top: 60px;
    margin-bottom: 80px;
  }
  .catalog-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 36px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 18px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .catalog-header-row h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.3rem);
    font-weight: 900;
    letter-spacing: -0.5px;
    margin-bottom: 6px;
  }
  .catalog-header-row p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .sort-indicator {
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .pro-grid-4col {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 32px;
  }

  /* Empty State Banner */
  .empty-state-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 60px 30px;
    text-align: center;
    max-width: 820px;
    margin: 40px auto 60px;
    box-shadow: var(--shadow-sm);
  }
  .empty-state-badge {
    display: inline-block;
    background: var(--blue-light);
    color: var(--blue-hover);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .empty-state-card h3 {
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--text);
    margin-bottom: 14px;
  }
  .empty-state-card p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 650px;
    margin: 0 auto 30px;
  }
  .empty-state-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-empty-hero {
    background: var(--blue-primary);
    color: #ffffff;
    padding: 12px 28px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .btn-empty-hero:hover {
    background: var(--blue-hover);
  }
  .btn-empty-outline {
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .btn-empty-outline:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
  }

  /* Fabric Authority */
  .fabric-authority-section {
    background: #0f172a;
    color: #ffffff;
    padding: 90px 0;
  }
  .authority-box {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }
  @media(max-width: 900px) {
    .authority-box { grid-template-columns: 1fr; }
  }
  .quality-tag {
    color: #38bdf8;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 14px;
  }
  .authority-text h2 {
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    font-weight: 900;
    letter-spacing: -0.8px;
    margin-bottom: 20px;
    line-height: 1.15;
  }
  .authority-text p {
    color: #94a3b8;
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .authority-text strong {
    color: #ffffff;
  }
  .spec-badges-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 30px 0;
  }
  .spec-pill {
    background: #1e293b;
    border: 1px solid #334155;
    color: #e2e8f0;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 7px 14px;
    border-radius: 6px;
  }
  .authority-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .btn-learn-sizing {
    display: inline-block;
    background: var(--blue-primary);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .btn-learn-sizing:hover {
    background: var(--blue-hover);
  }
  .btn-learn-secondary {
    display: inline-block;
    border: 1px solid #334155;
    color: #e2e8f0;
    padding: 12px 22px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .btn-learn-secondary:hover {
    border-color: #38bdf8;
    color: #38bdf8;
  }
