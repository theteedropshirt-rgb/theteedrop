---
import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../data/categories.json';

const BASE_URL = "https://theteedrop.com";
const MAYZING_STORE = "https://ecotwins.store";

const subcultures = categories.filter(c => c.group === 'subculture');
const professions = categories.filter(c => c.group === 'profession');
const gifts = categories.filter(c => c.group === 'gifts');
const styles = categories.filter(c => c.group === 'style');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": BASE_URL },
    { "@type": "ListItem", "position": 2, "name": "Collections", "item": `${BASE_URL}/collections` }
  ]
};
---

<BaseLayout
  title="All Topic Collections & Niche Graphic Hubs | The Tee Drop"
  description="Explore 45+ graphic apparel hubs across subcultures, professions, milestone birthdays, and heavyweight garment styles. 240+ GSM combed cotton printed on demand."
  schema={breadcrumbSchema}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <strong>Collections</strong>
    </nav>

    <div class="collections-header">
      <span class="badge">Master Catalog Directory</span>
      <h1>All Topic Collections & Graphic Hubs</h1>
      <p>Browse our 45+ curated niche hubs organized by subculture, profession, milestone occasion, and garment style. Every piece is crafted on our signature 240+ GSM combed heavyweight blanks.</p>
    </div>

    <!-- Group 1: Subcultures & Aesthetics -->
    <section class="catalog-group">
      <div class="group-header">
        <span class="group-tag">Aesthetics & Hobbies</span>
        <h2>Subcultures & Passions ({subcultures.length} Hubs)</h2>
      </div>
      <div class="collections-grid">
        {subcultures.map((c) => (
          <a href={`/collections/${c.slug}`} class="collection-card">
            <span class="card-badge">{c.badge}</span>
            <h3>{c.name}</h3>
            <p>{c.intro.slice(0, 115)}...</p>
            <span class="card-link">Explore Hub →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Group 2: Professions & Trades -->
    <section class="catalog-group">
      <div class="group-header">
        <span class="group-tag">Careers & Trade Pride</span>
        <h2>Professions & Blue-Collar Trades ({professions.length} Hubs)</h2>
      </div>
      <div class="collections-grid">
        {professions.map((c) => (
          <a href={`/collections/${c.slug}`} class="collection-card">
            <span class="card-badge">{c.badge}</span>
            <h3>{c.name}</h3>
            <p>{c.intro.slice(0, 115)}...</p>
            <span class="card-link">Explore Hub →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Group 3: Milestones & Gifts -->
    <section class="catalog-group">
      <div class="group-header">
        <span class="group-tag">Occasions & Milestones</span>
        <h2>Birthdays & Meaningful Gifts ({gifts.length} Hubs)</h2>
      </div>
      <div class="collections-grid">
        {gifts.map((c) => (
          <a href={`/collections/${c.slug}`} class="collection-card">
            <span class="card-badge">{c.badge}</span>
            <h3>{c.name}</h3>
            <p>{c.intro.slice(0, 115)}...</p>
            <span class="card-link">Explore Hub →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Group 4: Garment Styles -->
    <section class="catalog-group">
      <div class="group-header">
        <span class="group-tag">Fabric & Silhouette</span>
        <h2>Garment Cuts & Blank Standards ({styles.length} Hubs)</h2>
      </div>
      <div class="collections-grid">
        {styles.map((c) => (
          <a href={`/collections/${c.slug}`} class="collection-card">
            <span class="card-badge">{c.badge}</span>
            <h3>{c.name}</h3>
            <p>{c.intro.slice(0, 115)}...</p>
            <span class="card-link">Explore Hub →</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Crosslinks Box -->
    <aside class="guides-crosslink-box">
      <h3>Need Sizing or Care Guidance?</h3>
      <p>Consult our official garment specifications and care essays before placing an order.</p>
      <div class="guide-actions">
        <a href="/size-guide" class="btn-guide-pill">View Size & Fit Guide (Inches & CM) →</a>
        <a href="/blog" class="btn-guide-pill">The Journal: Fabric & Care Guides →</a>
        <a href={MAYZING_STORE} target="_blank" rel="noopener" class="btn-guide-pill btn-highlight">Mayzing Storefront →</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .collections-header {
    text-align: center;
    max-width: 800px;
    margin: 20px auto 60px;
  }
  .badge {
    display: inline-block;
    background: var(--blue-light);
    color: var(--blue-hover);
    padding: 4px 14px;
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .collections-header h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 900;
    letter-spacing: -0.8px;
    margin-bottom: 14px;
  }
  .collections-header p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  .catalog-group {
    margin-bottom: 70px;
  }
  .group-header {
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
    padding-bottom: 12px;
  }
  .group-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--blue-primary);
    text-transform: uppercase;
    letter-spacing: 1px;
    display: block;
    margin-bottom: 6px;
  }
  .group-header h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text);
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 22px;
  }
  .collection-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.25s ease;
  }
  .collection-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
    border-color: var(--blue-primary);
  }
  .card-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--blue-hover);
    background: var(--blue-light);
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  .collection-card h3 {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: #0f172a;
  }
  .collection-card p {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 18px;
    flex-grow: 1;
  }
  .card-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--blue-primary);
  }

  .guides-crosslink-box {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px;
    margin: 40px 0 90px;
    text-align: center;
  }
  .guides-crosslink-box h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 8px;
  }
  .guides-crosslink-box p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 24px;
  }
  .guide-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .btn-guide-pill {
    background: #ffffff;
    border: 1px solid var(--border);
    color: var(--text);
    padding: 10px 20px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.88rem;
  }
  .btn-guide-pill:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
  }
  .btn-highlight {
    background: var(--blue-primary);
    color: #ffffff;
    border-color: var(--blue-primary);
  }
  .btn-highlight:hover {
    background: var(--blue-hover);
    color: #ffffff;
  }
</style>
