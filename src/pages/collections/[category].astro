---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';

export async function getStaticPaths() {
  return categories.map((cat) => {
    const filteredProducts = products.filter((p) => p.category_slug === cat.slug);
    return {
      params: { category: cat.slug },
      props: { categoryData: cat, matchingProducts: filteredProducts }
    };
  });
}

const { categoryData, matchingProducts } = Astro.props;
const BASE_URL = "https://theteedrop.com";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": BASE_URL },
    { "@type": "ListItem", "position": 2, "name": "Collections", "item": `${BASE_URL}/collections` },
    { "@type": "ListItem", "position": 3, "name": categoryData.name, "item": `${BASE_URL}/collections/${categoryData.slug}` }
  ]
};

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": categoryData.meta_title,
  "description": categoryData.meta_description,
  "url": `${BASE_URL}/collections/${categoryData.slug}`,
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": matchingProducts.map((p, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `${BASE_URL}/products/${p.slug}`,
      "name": p.title
    }))
  }
};

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [breadcrumbSchema, collectionSchema]
};
---

<BaseLayout
  title={categoryData.meta_title}
  description={categoryData.meta_description}
  schema={pageSchema}
>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/collections">Collections</a>
      <span>/</span>
      <strong>{categoryData.name}</strong>
    </nav>

    <div class="cat-header">
      <div class="header-badge">{categoryData.badge}</div>
      <h1>{categoryData.h1}</h1>
      <p class="cat-intro">{categoryData.intro}</p>
      
      <div class="meta-strip">
        <span>240+ GSM Heavyweight Combed Cotton</span>
        <span>•</span>
        <span>Unisex Relaxed Streetwear Drape</span>
        <span>•</span>
        <span>3–6 Day US & European Delivery</span>
      </div>
    </div>

    <section class="drops-container">
      <div class="results-bar">
        <span>{matchingProducts.length > 0 ? `Showing ${matchingProducts.length} curated drops` : 'Next Drops Curating'}</span>
        <div class="quick-nav-links">
          <a href="/size-guide" class="size-link">View Sizing Guide →</a>
          <a href="/collections" class="all-link">All Collections →</a>
        </div>
      </div>

      {matchingProducts.length > 0 ? (
        <div class="product-grid">
          {matchingProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="empty-category-card">
          <span class="empty-badge">COLLECTION ARCHIVE & QUEUE</span>
          <h2>New {categoryData.name} Releases In Production</h2>
          <p>
            Every piece in our {categoryData.name} series is printed on demand using certified water-based inks on our custom 240+ GSM combed heavyweight blanks. We are currently formatting new artist submissions for this category.
          </p>
          <div class="empty-actions">
            <a href="/collections" class="btn-empty-primary">Browse All Collections</a>
            <a href="/size-guide" class="btn-empty-secondary">Check Sizing & Fit Specs</a>
            <a href="/" class="btn-empty-outline">Return to Home</a>
          </div>
        </div>
      )}
    </section>

    <!-- Comprehensive Internal Linking to Other Collections (SEO Hub & Spoke) -->
    <aside class="related-hubs">
      <div class="hub-header">
        <h3>Explore Other Popular Collections</h3>
        <p>Cross-browse our heavyweight graphic apparel hubs across all aesthetics and themes.</p>
      </div>
      <div class="related-pills">
        {categories.filter(c => c.slug !== categoryData.slug).map((c) => (
          <a href={`/collections/${c.slug}`} class="related-pill">
            {c.name}
          </a>
        ))}
        <a href="/collections" class="related-pill pill-highlight">View All Categories →</a>
        <a href="/size-guide" class="related-pill">Garment Size Chart</a>
        <a href="/blog" class="related-pill">The Journal & Care</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .cat-header {
    max-width: 850px;
    margin: 10px auto 40px;
    text-align: center;
  }
  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--blue-light);
    color: var(--blue-hover);
    padding: 5px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 18px;
  }
  .cat-header h1 {
    font-size: clamp(2.2rem, 4.5vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.8px;
    margin-bottom: 16px;
  }
  .cat-intro {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .meta-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--blue-primary);
  }

  .drops-container {
    margin-bottom: 80px;
  }
  .results-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .quick-nav-links {
    display: flex;
    gap: 16px;
  }
  .size-link, .all-link {
    color: var(--blue-primary);
    font-weight: 600;
  }
  .size-link:hover, .all-link:hover {
    text-decoration: underline;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 32px;
  }

  /* Empty State Styling */
  .empty-category-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 60px 30px;
    text-align: center;
    max-width: 800px;
    margin: 40px auto 60px;
    box-shadow: var(--shadow-sm);
  }
  .empty-badge {
    display: inline-block;
    background: #f1f5f9;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 1px;
    padding: 4px 12px;
    border-radius: 4px;
    margin-bottom: 18px;
  }
  .empty-category-card h2 {
    font-size: 1.8rem;
    font-weight: 800;
    margin-bottom: 14px;
    color: var(--text);
  }
  .empty-category-card p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 640px;
    margin: 0 auto 30px;
  }
  .empty-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .btn-empty-primary {
    background: var(--blue-primary);
    color: #ffffff;
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .btn-empty-primary:hover {
    background: var(--blue-hover);
  }
  .btn-empty-secondary {
    background: var(--bg-soft);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 12px 24px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .btn-empty-secondary:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
  }
  .btn-empty-outline {
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 12px 20px;
    border-radius: 6px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .related-hubs {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 40px;
    margin: 60px 0 80px;
    text-align: center;
  }
  .hub-header h3 {
    font-size: 1.3rem;
    font-weight: 800;
    margin-bottom: 6px;
  }
  .hub-header p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 22px;
  }
  .related-pills {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .related-pill {
    background: #ffffff;
    border: 1px solid var(--border);
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
  }
  .related-pill:hover {
    border-color: var(--blue-primary);
    color: var(--blue-primary);
    transform: translateY(-1px);
  }
  .pill-highlight {
    background: var(--blue-light);
    color: var(--blue-hover);
    border-color: transparent;
  }
</style>
