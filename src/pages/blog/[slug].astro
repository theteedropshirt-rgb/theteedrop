---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articles from '../../data/articles.json';

export async function getStaticPaths() {
 return articles.map((a) => ({
 params: { slug: a.slug },
 props: { article: a }
 }));
}

const { article } = Astro.props;
const BASE_URL = "https://theteedrop.com";

const blogSchema = {
 "@context": "https://schema.org",
 "@type": "BlogPosting",
 "headline": article.title,
 "image": [article.image],
 "datePublished": "2026-11-01",
 "dateModified": "2026-11-05",
 "author": {
 "@type": "Person",
 "name": article.author
 },
 "publisher": {
 "@type": "Organization",
 "name": "The Tee Drop",
 "url": BASE_URL
 },
 "description": article.excerpt
};

const breadcrumbSchema = {
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [
 { "@type": "ListItem", "position": 1, "name": "Home", "item": BASE_URL },
 { "@type": "ListItem", "position": 2, "name": "Journal", "item": `${BASE_URL}/blog` },
 { "@type": "ListItem", "position": 3, "name": article.title, "item": `${BASE_URL}/blog/${article.slug}` }
 ]
};

const pageSchema = {
 "@context": "https://schema.org",
 "@graph": [blogSchema, breadcrumbSchema]
};
---

<BaseLayout
 title={`${article.title} | The Tee Drop Journal`}
 description={article.excerpt}
 image={article.image}
 schema={pageSchema}
>
 <div class="container">
 <nav class="breadcrumbs" aria-label="Breadcrumb">
 <a href="/">Home</a>
 <span>/</span>
 <a href="/blog">Journal</a>
 <span>/</span>
 <strong>{article.title}</strong>
 </nav>

 <article class="article-wrapper">
 <header class="article-header">
 <span class="badge">The Tee Drop Journal</span>
 <h1>{article.title}</h1>
 <div class="byline">By {article.author} • {article.date} • {article.read_time}</div>
 </header>

 <div class="hero-image">
 <img src={article.image} alt={article.title} width="800" height="450" />
 </div>

 <div class="prose" set:html={article.content} />

 <div class="article-cta">
 <h4>Experience The Heavyweight Standard</h4>
 <p>Explore our latest limited-run graphic drops printed on 240+ GSM combed cotton with free US & EU delivery over $50.</p>
 <a href="/collections" class="btn-cta">Explore Live Collections →</a>
 </div>

 <div class="back-link">
 <a href="/blog">← Back to all journal articles</a>
 </div>
 </article>
 </div>
</BaseLayout>

<style>
 .article-wrapper {
 max-width: 780px;
 margin: 10px auto 80px;
 }
 .article-header {
 text-align: center;
 margin-bottom: 35px;
 }
 .badge {
 display: inline-block;
 background: var(--blue-light);
 color: var(--blue-hover);
 padding: 4px 14px;
 border-radius: 999px;
 font-size: 0.8rem;
 font-weight: 700;
 margin-bottom: 16px;
 }
 .article-header h1 {
 font-size: clamp(2rem, 4vw, 2.6rem);
 font-weight: 800;
 line-height: 1.25;
 letter-spacing: -0.8px;
 margin-bottom: 16px;
 color: var(--text);
 }
 .byline {
 color: var(--text-muted);
 font-size: 0.9rem;
 }

 .hero-image {
 border-radius: var(--radius-lg);
 overflow: hidden;
 margin-bottom: 40px;
 border: 1px solid var(--border);
 }
 .hero-image img { width: 100%; height: auto; display: block; }

 .prose {
 font-size: 1.1rem;
 line-height: 1.85;
 color: #334155;
 }
 :global(.prose p) { margin-bottom: 24px; }
 :global(.prose h3) {
 font-size: 1.45rem;
 font-weight: 700;
 color: var(--text);
 margin: 36px 0 16px;
 letter-spacing: -0.4px;
 }
 :global(.prose ul) { margin: 0 0 24px 24px; }
 :global(.prose li) { margin-bottom: 10px; }

 .article-cta {
 background: var(--bg-sky);
 border: 1px solid #bae6fd;
 border-radius: var(--radius-md);
 padding: 36px;
 margin-top: 50px;
 text-align: center;
 }
 .article-cta h4 {
 font-size: 1.3rem;
 font-weight: 800;
 margin-bottom: 10px;
 color: var(--text);
 }
 .article-cta p {
 color: var(--text-muted);
 margin-bottom: 22px;
 font-size: 0.95rem;
 max-width: 550px;
 margin-left: auto;
 margin-right: auto;
 }
 .btn-cta {
 display: inline-block;
 background: var(--blue-primary);
 color: #ffffff;
 padding: 12px 26px;
 border-radius: 999px;
 font-weight: 600;
 font-size: 0.95rem;
 }
 .btn-cta:hover { background: var(--blue-hover); }

 .back-link {
 margin-top: 36px;
 text-align: center;
 }
 .back-link a {
 color: var(--blue-primary);
 font-weight: 600;
 font-size: 0.9rem;
 }
</style>
