---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articles from '../../data/articles.json';
import products from '../../data/products.json';

export async function getStaticPaths() {
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a }
  }));
}

const { article } = Astro.props;
const BASE_URL = "https://theteedrop.com";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt,
  "image": `${BASE_URL}${article.image}`,
  "datePublished": "2026-11-06",
  "dateModified": "2026-11-06",
  "author": {
    "@type": "Organization",
    "name": "The Tee Drop",
    "url": BASE_URL
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Tee Drop",
    "url": BASE_URL
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `${BASE_URL}/blog/${article.slug}`
  }
};

const otherArticles = articles.filter(a => a.slug !== article.slug).slice(0, 3);
---

<BaseLayout
  title={`${article.title} | The Tee Drop`}
  description={article.excerpt}
  image={article.image}
  schema={articleSchema}
>
  <article class="article-detail-page">
    <div class="container article-container">

      <!-- Breadcrumbs -->
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Accueil</a>
        <span>/</span>
        <a href="/blog">Journal</a>
        <span>/</span>
        <strong>{article.title}</strong>
      </nav>

      <!-- Header -->
      <header class="article-header">
        <div class="article-header-meta">
          <span class="art-category-pill">{article.category}</span>
          <span class="art-event-pill">Événement : {article.event}</span>
        </div>
        <h1>{article.title}</h1>
        <p class="article-lead-subtitle">{article.subtitle}</p>
        <div class="article-byline">
          <span>Par l'équipe The Tee Drop</span>
          <span class="dot-sep">•</span>
          <span>{article.date}</span>
          <span class="dot-sep">•</span>
          <span>{article.read_time}</span>
        </div>
      </header>

      <!-- Featured Visual -->
      <div class="article-hero-media">
        <img src={article.image} alt={article.title} />
      </div>

      <!-- Main Prose Body -->
      <div class="article-prose" set:html={article.content} />

      <!-- Direct Featured Drop Showcase Box -->
      <section class="featured-drop-box">
        <div class="drop-box-content">
          <span class="drop-status-pill">Drop en vedette</span>
          <h3>Brew York Christmas Cafe Tour Collection</h3>
          <p>
            Imprimé sur commande sur nos pièces en coton peigné et molleton lourd. Choisissez votre modèle idéal pour les fêtes :
          </p>

          <div class="drop-options-grid">
            <a href="https://ecotwins.store/christmas-cafe-tour?productId=6aee5609d61c00b33230b901" target="_blank" rel="noopener" class="drop-option-card">
              <span class="garment-name">T-Shirt Unisexe</span>
              <span class="garment-price">19,99 $US</span>
              <span class="garment-btn">Commander le T-Shirt →</span>
            </a>
            <a href="https://ecotwins.store/christmas-cafe-tour?productId=6aee5609d2bd9d186b43718b" target="_blank" rel="noopener" class="drop-option-card">
              <span class="garment-name">Sweat-shirt Chaud</span>
              <span class="garment-price">24,99 $US</span>
              <span class="garment-btn">Commander le Sweat →</span>
            </a>
            <a href="https://ecotwins.store/christmas-cafe-tour?productId=6aee5608d2bd9d186b436e62" target="_blank" rel="noopener" class="drop-option-card">
              <span class="garment-name">Manches Longues</span>
              <span class="garment-price">24,99 $US</span>
              <span class="garment-btn">Commander le Manches Longues →</span>
            </a>
          </div>
        </div>
      </section>

      <!-- More from the Journal -->
      {otherArticles.length > 0 && (
        <section class="related-journal-section">
          <h3>À lire également dans le Journal</h3>
          <div class="related-grid">
            {otherArticles.map((rel) => (
              <a href={`/blog/${rel.slug}`} class="related-card">
                <img src={rel.image} alt={rel.title} loading="lazy" />
                <div class="related-body">
                  <span class="rel-cat">{rel.category}</span>
                  <h4>{rel.title}</h4>
                  <span class="rel-read">{rel.read_time}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

    </div>
  </article>
</BaseLayout>

<style>
  .article-detail-page {
    padding: 24px 0 80px;
    background: #ffffff;
  }
  .article-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 28px;
  }
  .article-header-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .art-category-pill {
    background: #f3f4f6;
    color: #111827;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 10px;
    border-radius: 4px;
  }
  .art-event-pill {
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 4px;
  }

  .article-header h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.25;
    margin-bottom: 12px;
    letter-spacing: -0.5px;
  }
  .article-lead-subtitle {
    font-size: 1.15rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 16px;
  }
  .article-byline {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #6b7280;
  }
  .dot-sep { color: #d1d5db; }

  .article-hero-media {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 36px;
    background: #f9fafb;
    border: 1px solid #e5e7eb;
  }
  .article-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Prose Styling */
  .article-prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #374151;
    margin-bottom: 48px;
  }
  .article-prose :global(h2) {
    font-size: 1.55rem;
    font-weight: 800;
    color: #111827;
    margin: 36px 0 14px;
    line-height: 1.3;
  }
  .article-prose :global(h3) {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin: 28px 0 10px;
  }
  .article-prose :global(p) {
    margin-bottom: 20px;
  }
  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 0 0 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .article-prose :global(li) {
    line-height: 1.6;
  }

  /* Featured Drop Box */
  .featured-drop-box {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 60px;
  }
  .drop-status-pill {
    display: inline-block;
    background: #111827;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 4px;
    margin-bottom: 10px;
  }
  .drop-box-content h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 6px;
  }
  .drop-box-content p {
    color: #6b7280;
    font-size: 0.92rem;
    margin-bottom: 20px;
  }

  .drop-options-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media(max-width: 680px) {
    .drop-options-grid { grid-template-columns: 1fr; }
  }

  .drop-option-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .drop-option-card:hover {
    border-color: #111827;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
  }
  .garment-name {
    font-size: 0.9rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 4px;
  }
  .garment-price {
    font-size: 1.1rem;
    font-weight: 800;
    color: #111827;
    margin-bottom: 10px;
  }
  .garment-btn {
    font-size: 0.8rem;
    font-weight: 600;
    color: #0284c7;
    margin-top: auto;
  }

  /* Related Journal */
  .related-journal-section {
    border-top: 1px solid #e5e7eb;
    padding-top: 36px;
  }
  .related-journal-section h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 20px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media(max-width: 680px) {
    .related-grid { grid-template-columns: 1fr; }
  }
  .related-card {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .related-card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .related-body {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .rel-cat {
    font-size: 0.72rem;
    font-weight: 700;
    color: #0284c7;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .related-body h4 {
    font-size: 0.92rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.35;
    margin-bottom: 8px;
    flex: 1;
  }
  .rel-read {
    font-size: 0.75rem;
    color: #9ca3af;
  }
</style>
