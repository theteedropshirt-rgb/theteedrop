---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import articles from '../../data/articles.json';

const BASE_URL = "https://theteedrop.com";

const breadcrumbSchema = {
 "@context": "https://schema.org",
 "@type": "BreadcrumbList",
 "itemListElement": [
 { "@type": "ListItem", "position": 1, "name": "Home", "item": BASE_URL },
 { "@type": "ListItem", "position": 2, "name": "Journal", "item": `${BASE_URL}/blog` }
 ]
};
---

<BaseLayout
 title="The Journal | Fabric Guides, Styling & Print Care | The Tee Drop"
 description="Read editorial guides from The Tee Drop. Insights on 240+ GSM heavyweight cotton, oversized styling rules, and caring for water-based DTG prints."
 schema={breadcrumbSchema}
>
 <div class="container">
 <nav class="breadcrumbs" aria-label="Breadcrumb">
 <a href="/">Home</a>
 <span>/</span>
 <strong>Journal</strong>
 </nav>

 <header class="blog-header">
 <span class="badge">The Journal</span>
 <h1>Stories, Care & Craftsmanship</h1>
 <p>Thoughtful essays on garment construction, fabric longevity, and the evolution of graphic t-shirt culture.</p>
 </header>

 <div class="blog-grid">
 {articles.map((a) => (
 <ArticleCard article={a} />
 ))}
 </div>
 </div>
</BaseLayout>

<style>
 .blog-header {
 text-align: center;
 max-width: 750px;
 margin: 20px auto 60px;
 }
 .badge {
 display: inline-block;
 background: var(--blue-light);
 color: var(--blue-hover);
 padding: 4px 14px;
 border-radius: 999px;
 font-size: 0.8rem;
 font-weight: 700;
 margin-bottom: 16px;
 }
 .blog-header h1 {
 font-size: clamp(2rem, 4vw, 2.8rem);
 font-weight: 800;
 letter-spacing: -0.8px;
 margin-bottom: 14px;
 }
 .blog-header p {
 color: var(--text-muted);
 font-size: 1.05rem;
 line-height: 1.6;
 }
 .blog-grid {
 display: grid;
 grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
 gap: 32px;
 margin-bottom: 80px;
 }
</style>
