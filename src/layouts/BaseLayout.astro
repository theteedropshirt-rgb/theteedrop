---
interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  schema?: any;
}

const {
  title,
  description,
  image = "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=900&auto=format&fit=crop&q=80",
  canonical = Astro.url.href,
  schema
} = Astro.props;

const BASE_URL = "https://theteedrop.com";
const MAYZING_DEFAULT = "https://ecotwins.store";

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "The Tee Drop",
  "url": BASE_URL,
  "logo": `${BASE_URL}/images/logo.png`,
  "sameAs": [
    "https://www.tiktok.com/@theteedrop",
    "https://www.pinterest.com/theteedrop",
    "https://www.instagram.com/theteedrop"
  ]
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs Context" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <style is:global>
    :root {
      --bg: #ffffff;
      --bg-light: #f9fafb;
      --bg-input: #f3f4f6;
      --border: #e5e7eb;
      --border-dark: #d1d5db;
      --text: #111827;
      --text-muted: #6b7280;
      --text-light: #9ca3af;
      --primary: #111827;
      --primary-hover: #1f2937;
      --blue: #0284c7;
      --font-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; display: block; }

    /* Top Announcement Bar */
    .top-announcement {
      background: #111827;
      color: #f9fafb;
      font-size: 0.8rem;
      font-weight: 500;
      text-align: center;
      padding: 8px 16px;
      letter-spacing: 0.3px;
    }

    /* Main Modern Mayzing Header */
    header.site-header {
      background: #ffffff;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 14px 24px;
      max-width: 1400px;
      margin: 0 auto;
    }

    /* Brand Logo */
    .brand-logo {
      font-size: 1.45rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      color: #111827;
      text-transform: lowercase;
      white-space: nowrap;
    }

    /* Search Bar in Header */
    .header-search-wrap {
      flex: 1;
      max-width: 680px;
      position: relative;
    }
    .header-search-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 10px 42px 10px 16px;
      font-size: 0.92rem;
      color: #111827;
      outline: none;
      transition: all 0.2s ease;
    }
    .header-search-input:focus {
      background: #ffffff;
      border-color: #d1d5db;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
    }
    .header-search-input::placeholder {
      color: #9ca3af;
    }
    .search-icon-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: #6b7280;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
    }
    .search-icon-btn:hover {
      color: #111827;
    }

    /* Header Nav & Actions */
    .header-right-actions {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .header-nav-links {
      display: flex;
      align-items: center;
      gap: 18px;
      font-size: 0.88rem;
      font-weight: 500;
      color: #4b5563;
    }
    .header-nav-links a:hover {
      color: #111827;
    }
    @media(max-width: 860px) {
      .header-nav-links { display: none; }
    }

    /* Cart Button with Counter */
    .cart-btn {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #111827;
      padding: 6px;
      transition: transform 0.15s ease;
    }
    .cart-btn:hover {
      transform: scale(1.05);
    }
    .cart-badge {
      position: absolute;
      top: 2px;
      right: 0px;
      background: #111827;
      color: #ffffff;
      font-size: 0.65rem;
      font-weight: 700;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Container */
    .container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* Breadcrumbs */
    .breadcrumbs {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin: 16px 0 20px;
    }
    .breadcrumbs a:hover { color: var(--primary); }
    .breadcrumbs span { color: #d1d5db; }

    /* Footer */
    footer {
      background: #ffffff;
      border-top: 1px solid var(--border);
      color: #4b5563;
      padding: 60px 0 30px;
      margin-top: 80px;
      font-size: 0.88rem;
    }
    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.2fr;
      gap: 40px;
      margin-bottom: 40px;
    }
    @media(max-width: 850px) {
      .footer-grid { grid-template-columns: 1fr; gap: 30px; }
    }
    .footer-brand h4 { color: #111827; font-size: 1.25rem; margin-bottom: 12px; font-weight: 800; text-transform: lowercase; }
    .footer-brand p { color: #6b7280; font-size: 0.9rem; line-height: 1.6; max-width: 360px; }
    .footer-col h5 { color: #111827; font-size: 0.88rem; margin-bottom: 14px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700; }
    .footer-col ul { list-style: none; }
    .footer-col ul li { margin-bottom: 8px; }
    .footer-col ul li a { color: #6b7280; }
    .footer-col ul li a:hover { color: #111827; }
    .footer-bottom {
      border-top: 1px solid var(--border);
      padding-top: 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      color: #9ca3af;
      font-size: 0.82rem;
    }
    @media(max-width: 600px) {
      .footer-bottom { flex-direction: column; gap: 10px; text-align: center; }
    }
  </style>
</head>
<body>
  <!-- Top Announcement Bar -->
  <div class="top-announcement">
    Printed on Demand • Worldwide Tracked Shipping • 30-Day Quality Guarantee
  </div>

  <!-- Modern Storefront Header (Mayzing Aesthetic) -->
  <header class="site-header">
    <div class="header-inner">
      <!-- Logo -->
      <a href="/" class="brand-logo" title="The Tee Drop Storefront">
        theteedrop
      </a>

      <!-- Search Bar -->
      <div class="header-search-wrap">
        <form action="/" method="GET" id="search-form" onsubmit="event.preventDefault(); window.searchStore && window.searchStore();">
          <input
            type="search"
            id="store-search-input"
            class="header-search-input"
            placeholder="Chercher"
            autocomplete="off"
          />
          <button type="submit" class="search-icon-btn" aria-label="Search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
        </form>
      </div>

      <!-- Actions -->
      <div class="header-right-actions">
        <nav class="header-nav-links">
          <a href="/collections">Collections</a>
          <a href="/size-guide">Guide des tailles</a>
          <a href="/blog">Guides</a>
        </nav>

        <a href={MAYZING_DEFAULT} class="cart-btn" target="_blank" rel="noopener" aria-label="Panier">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
          <span class="cart-badge">1</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Page Slot -->
  <slot />

  <!-- Professional Clean Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-brand">
          <h4>theteedrop</h4>
          <p>
            Graphic apparel and print-on-demand streetwear crafted on heavyweight combed cotton blanks. Localized fulfillment across the USA, Canada, and Europe.
          </p>
        </div>

        <div class="footer-col">
          <h5>Magasin</h5>
          <ul>
            <li><a href="/collections">Toutes les collections (45+)</a></li>
            <li><a href="/collections/coffee-obsessed">Coffee Culture</a></li>
            <li><a href="/collections/gym-pump-covers">Gym Pump Covers</a></li>
            <li><a href="/collections/vintage-streetwear">Vintage Streetwear</a></li>
            <li><a href="/collections/anime-cyberpunk">Anime & Cyberpunk</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h5>Aide & Guides</h5>
          <ul>
            <li><a href="/size-guide">Guide des Tailles (Inches / CM)</a></li>
            <li><a href="/blog/dtg-print-washing-care-guide">Conseils de Lavage</a></li>
            <li><a href="/blog/gsm-fabric-weight-guide">Guide des Tissus 240+ GSM</a></li>
            <li><a href="/sitemap.xml">Plan du site (XML)</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h5>Garantie</h5>
          <p style="font-size: 0.85rem; color: #6b7280; line-height: 1.6; margin-bottom: 12px;">
            Garantie réimpression sous 30 jours pour tout défaut d'impression ou de taille.
          </p>
          <p style="font-size: 0.82rem; color: #16a34a; font-weight: 600;">
            ✓ Paiement 100% sécurisé via Mayzing
          </p>
        </div>
      </div>

      <div class="footer-bottom">
        <p>&copy; {new Date().getFullYear()} The Tee Drop. Tous droits réservés.</p>
        <p>Paiements sécurisés cryptés SSL</p>
      </div>
    </div>
  </footer>
</body>
</html>
