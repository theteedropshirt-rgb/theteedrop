---
interface Props {
  product: {
    id: string;
    slug: string;
    title: string;
    subtitle?: string;
    type?: string;
    gender?: string;
    price: number;
    compare_at_price?: number;
    category: string;
    category_slug?: string;
    badge?: string;
    rating?: number;
    reviews_count?: number;
    colors?: { name: string; hex: string }[];
    image_front?: string;
    image_back?: string;
    image?: string;
    description: string;
    mayzing_checkout_url?: string;
  };
}

const { product } = Astro.props;
const checkoutLink = product.mayzing_checkout_url || `/products/${product.slug}`;
const frontImg = product.image_front || product.image || "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?w=900&auto=format&fit=crop&q=80";
const backImg = product.image_back || frontImg;
const colors = product.colors || [{ name: "White", hex: "#ffffff" }];
const visibleColors = colors.slice(0, 7);
const extraColorsCount = colors.length > 7 ? colors.length - 7 : 0;
---

<article class="mayzing-product-card" data-category={product.type || "T-Shirts"} data-gender={product.gender || "Unisexe"} data-title={product.title.toLowerCase()}>
  <a href={`/products/${product.slug}`} class="card-image-box">
    <img src={frontImg} alt={product.title} class="card-img-front" loading="lazy" />
    <img src={backImg} alt={product.title} class="card-img-back" loading="lazy" />
    {product.badge && <span class="card-badge">{product.badge}</span>}
  </a>

  <div class="card-details">
    <!-- Swatch Dots -->
    <div class="swatches-row">
      {visibleColors.map((c) => (
        <span
          class="swatch-dot"
          style={`background-color: ${c.hex}; ${c.hex.toLowerCase() === '#ffffff' ? 'border: 1px solid #d1d5db;' : ''}`}
          title={c.name}
        />
      ))}
      {extraColorsCount > 0 && <span class="swatch-extra">+{extraColorsCount}</span>}
    </div>

    <!-- Title -->
    <h3 class="card-title">
      <a href={`/products/${product.slug}`}>{product.title}</a>
    </h3>

    <!-- Subtitle (Garment type like Mayzing) -->
    <p class="card-subtitle">{product.subtitle || "T-Shirt unisexe classique"}</p>

    <!-- Price and Direct Order -->
    <div class="card-price-row">
      <div class="price-wrap">
        <span class="price-val">{product.price.toFixed(2).replace('.', ',')} $US</span>
        {product.compare_at_price && (
          <span class="compare-val">{product.compare_at_price.toFixed(2).replace('.', ',')} $US</span>
        )}
      </div>
      <a href={checkoutLink} class="btn-direct-buy" target="_blank" rel="noopener" title="Order Drop">
        Commander
      </a>
    </div>
  </div>
</article>

<style>
  .mayzing-product-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    position: relative;
  }
  .mayzing-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    border-color: #d1d5db;
  }

  .card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f9fafb;
    overflow: hidden;
    display: block;
  }
  .card-img-front,
  .card-img-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.3s ease, transform 0.35s ease;
  }
  .card-img-back {
    opacity: 0;
  }
  .card-image-box:hover .card-img-front {
    opacity: 0;
    transform: scale(1.03);
  }
  .card-image-box:hover .card-img-back {
    opacity: 1;
    transform: scale(1.03);
  }

  .card-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #111827;
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.3px;
    text-transform: uppercase;
    z-index: 2;
  }

  .card-details {
    padding: 14px 16px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .swatches-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .swatch-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
    display: inline-block;
  }
  .swatch-extra {
    font-size: 0.72rem;
    color: #6b7280;
    font-weight: 600;
    margin-left: 2px;
  }

  .card-title {
    font-size: 0.98rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin-bottom: 3px;
  }
  .card-title a {
    color: inherit;
    text-decoration: none;
  }
  .card-title a:hover {
    color: #0284c7;
  }

  .card-subtitle {
    font-size: 0.83rem;
    color: #6b7280;
    margin-bottom: 12px;
    font-weight: 400;
  }

  .card-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 6px;
  }
  .price-wrap {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .price-val {
    font-size: 0.98rem;
    font-weight: 800;
    color: #111827;
  }
  .compare-val {
    font-size: 0.8rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  .btn-direct-buy {
    font-size: 0.78rem;
    font-weight: 700;
    color: #111827;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    padding: 5px 12px;
    border-radius: 6px;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .btn-direct-buy:hover {
    background: #111827;
    color: #ffffff;
    border-color: #111827;
  }
</style>
