---
interface Props {
  product: {
    id: string;
    slug: string;
    title: string;
    subtitle?: string;
    type?: string;
    gender?: string;
    price: number;
    compare_at_price?: number;
    category: string;
    category_slug?: string;
    badge?: string;
    rating?: number;
    reviews_count?: number;
    colors?: { name: string; hex: string }[];
    image_front?: string;
    image_back?: string;
    image?: string;
    description: string;
    mayzing_checkout_url?: string;
  };
}

const { product } = Astro.props;
const targetLink = `/products/${product.slug}`;
const frontImg = product.image_front || product.image || "/images/products/christmas-cafe-tour-front.png";
const backImg = product.image_back || frontImg;
const colors = product.colors || [{ name: "White", hex: "#ffffff" }];
const visibleColors = colors.slice(0, 7);
const extraColorsCount = colors.length > 7 ? colors.length - 7 : 0;
---

<div class="mayzing-card-wrapper" data-category={product.type || "T-Shirts"} data-gender={product.gender || "Unisexe"} data-title={product.title.toLowerCase()}>
  <a href={targetLink} class="mayzing-product-card">
    <!-- Image Box -->
    <div class="card-image-box">
      <img src={frontImg} alt={product.title} class="card-img-front" loading="lazy" />
      <img src={backImg} alt={product.title} class="card-img-back" loading="lazy" />
    </div>

    <!-- Details Box -->
    <div class="card-details">
      <!-- Color Swatches Row -->
      <div class="swatches-row">
        {visibleColors.map((c) => (
          <span
            class="swatch-dot"
            style={`background-color: ${c.hex}; ${c.hex.toLowerCase() === '#ffffff' ? 'border: 1px solid #d1d5db;' : ''}`}
            title={c.name}
          />
        ))}
        {extraColorsCount > 0 && <span class="swatch-extra">+{extraColorsCount}</span>}
      </div>

      <!-- Title -->
      <h3 class="card-title">{product.title}</h3>

      <!-- Subtitle -->
      <div class="card-subtitle">{product.subtitle || "T-Shirt unisexe classique"}</div>

      <!-- Price -->
      <div class="card-price">{product.price.toFixed(2).replace('.', ',')} $US</div>
    </div>
  </a>
</div>

<style>
  .mayzing-card-wrapper {
    max-width: 320px;
    width: 100%;
  }

  .mayzing-product-card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .mayzing-product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.06);
    border-color: #d1d5db;
  }

  .card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #f9fafb;
    overflow: hidden;
    display: block;
  }
  .card-img-front,
  .card-img-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.25s ease;
  }
  .card-img-back {
    opacity: 0;
  }
  .mayzing-product-card:hover .card-img-front {
    opacity: 0;
  }
  .mayzing-product-card:hover .card-img-back {
    opacity: 1;
  }

  .card-details {
    padding: 12px 14px 16px;
    display: flex;
    flex-direction: column;
  }

  .swatches-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .swatch-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }
  .swatch-extra {
    font-size: 0.72rem;
    color: #6b7280;
    font-weight: 500;
    margin-left: 2px;
  }

  .card-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 2px 0;
    line-height: 1.3;
  }

  .card-subtitle {
    font-size: 0.82rem;
    color: #4b5563;
    margin-bottom: 6px;
  }

  .card-price {
    font-size: 0.92rem;
    font-weight: 600;
    color: #111827;
  }
</style>
